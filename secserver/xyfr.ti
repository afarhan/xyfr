# Xyfr handheld terminal — a deliberately small ANSI subset the device emulates.
#
# Build + install:  tic -x xyfr.ti          (into ~/.terminfo or $TERMINFO)
#   system-wide:    sudo tic -x -o /usr/share/terminfo xyfr.ti
# The terminal server (term_host.c) sets TERM=xyfr on the forked shell, so ncurses
# apps restrict themselves to exactly what the device renders.
#
# Deliberately absent (the device can't do them, so we never want them emitted):
#   setab (no independent background colour), 256-colour, UTF-8 (u8), mouse,
#   bracketed paste, insert-char/insert-mode. smcup/rmcup ARE advertised but the
#   device implements a light alt-screen (clear on enter/leave, no saved buffer).

xyfr|Xyfr handheld 80x25 ANSI subset,
	am, msgr, xon,
	cols#80, lines#25, colors#8, pairs#64,
	bel=^G, cr=\r, ind=\n, cud1=\n, cub1=\b, ht=\t, nel=\r\n,
	clear=\E[H\E[2J, home=\E[H, cup=\E[%i%p1%d;%p2%dH,
	cuu=\E[%p1%dA, cud=\E[%p1%dB, cuf=\E[%p1%dC, cub=\E[%p1%dD,
	cuu1=\E[A, cud1=\E[B, cuf1=\E[C, cub1=\E[D,
	hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
	el=\E[K, el1=\E[1K, ed=\E[J,
	il1=\E[L, dl1=\E[M,
	csr=\E[%i%p1%d;%p2%dr, sc=\E7, rc=\E8,
	civis=\E[?25l, cnorm=\E[?25h,
	smcup=\E[?1049h, rmcup=\E[?1049l,
	bold=\E[1m, rev=\E[7m, smul=\E[4m, rmul=\E[24m,
	sgr0=\E[0m, op=\E[39m,
	setaf=\E[3%p1%dm,
	smacs=\E(0, rmacs=\E(B, enacs=\E(B,
	acsc=``aa~~jjkkllmmnnqqttuuvvwwxx,
	kcuu1=\E[A, kcud1=\E[B, kcuf1=\E[C, kcub1=\E[D, kbs=\177,
